<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lihua</groupId>
    <artifactId>lihua</artifactId>
    <version>2.2.0</version>
    <packaging>pom</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>

        <project.version>2.2.0</project.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mysql.version>26.7.0</mysql.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <jwt.version>4.6.0</jwt.version>
        <redisson.version>4.7.0</redisson.version>
        <caffeine.version>3.2.4</caffeine.version>
        <oshi.version>7.3.1</oshi.version>
        <tianai-captcha.version>1.5.5</tianai-captcha.version>
        <ip2region.version>3.3.7</ip2region.version>
        <dynamic-datasource.version>4.5.0</dynamic-datasource.version>
        <fesod.version>2.0.2-incubating</fesod.version>
        <oss.version>3.18.5</oss.version>
        <spring-doc.version>3.1.0</spring-doc.version>
        <snail-job.version>2.0.2</snail-job.version>
    </properties>

    <dependencyManagement>
        <dependencies>
<!--            系统监控 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-monitor</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            系统业务 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-system</artifactId>
                <version>${project.version}</version>
            </dependency>

<!--            基础依赖=============================================-->
<!--            公共模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-common</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            字典模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-dict</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            文档模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-doc</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            excel导入导出模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-excel</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            ip处理模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-ip</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            日志模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-log</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            mybatis持久层模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-mybatis</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            缓存模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-cache</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            安全模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-security</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            数据脱敏模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-sensitive</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            websocket模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-websocket</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--            web模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-web</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            验证码模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-captcha</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            定时任务模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-job</artifactId>
                <version>${project.version}</version>
            </dependency>
<!--            附件模块 -->
            <dependency>
                <groupId>com.lihua</groupId>
                <artifactId>lihua-base-attachment</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>lihua-admin</module>
        <module>lihua-base</module>
        <module>lihua-biz</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
        <!--        指定打包后包含的文件-->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.properties</include>
                    <include>**/*.xml</include>
                    <include>**/*.yml</include>
                    <include>**/*.txt</include>
                    <include>META-INF/services/*</include>
                    <include>META-INF/spring/*</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.properties</include>
                    <include>**/*.xml</include>
                </includes>
            </resource>
        </resources>
    </build>
</project>
