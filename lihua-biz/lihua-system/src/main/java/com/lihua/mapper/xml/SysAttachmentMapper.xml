<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lihua.mapper.SysAttachmentMapper">

    <select id="queryDeletablePathByIds" resultType="java.lang.String">
        SELECT
            path
        FROM
            sys_attachment
        WHERE
            path IN ( SELECT path FROM sys_attachment WHERE id IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            <!-- status 字面量保持（XML 内不引枚举）；'2'=分片上传中（AttachmentStatusEnum.CHUNK_UPLOADING），del_flag=0 排除已逻辑删除行 -->
            AND path IS NOT NULL AND status != '2' AND del_flag = '0')
        GROUP BY path
        HAVING count( 1 ) = 1
    </select>


</mapper>